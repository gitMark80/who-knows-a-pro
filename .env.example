# Public application configuration
SITE_URL=https://whoknowsapro.com
ADMIN_EMAIL=hello@whoknowsapro.com
LEAD_NOTIFICATION_EMAIL=hello@whoknowsapro.com
CLAIM_EMAIL_FROM=Who Knows a Pro <claims@mail.whoknowsapro.com>
LEAD_RATE_LIMIT_PER_HOUR=5

# Cloudflare Turnstile (free). When TURNSTILE_SECRET_KEY is set, the claim and quote
# forms require a valid token verified server-side. Set both or neither; redeploy after
# setting NEXT_PUBLIC_TURNSTILE_SITE_KEY because it is built into the page.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional: secret salt for hashed rate-limit keys (any long random string).
RATE_LIMIT_SALT=

# Turso (created by the Vercel Marketplace integration)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Resend (created by the Vercel Marketplace integration)
RESEND_API_KEY=

# Vercel Blob (created by the Vercel project store)
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=
BLOB_WEBHOOK_PUBLIC_KEY=

# Stripe test mode. Leave live mode disabled until test purchase and cancellation pass.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_ENHANCED=price_1UJb0uFCr5Klr9CXefjlv86s
STRIPE_PRICE_ID_FEATURED=price_1UJb2hFCr5Klr9CXv1DufoCB
STRIPE_TAX_ENABLED=false
STRIPE_LIVE_MODE=false
